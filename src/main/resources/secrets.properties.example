# Copy this file to "secrets.properties" (same folder) and fill in your values.
# secrets.properties is git-ignored, so your passwords never reach GitHub.
# On Render, add the same names as Environment Variables instead.

# MySQL
DB_URL=jdbc:mysql://YOUR_HOST:YOUR_PORT/defaultdb?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=your-mysql-password

# Redis
REDIS_HOST=your-redis-host.cloud.redislabs.com
REDIS_PORT=12345
REDIS_PASSWORD=your-redis-password
